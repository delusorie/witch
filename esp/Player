local toolLookup = {}
pcall(function()
    local ToolData = require(cloneref(game.ReplicatedStorage.ModuleScripts.Data.ToolData))
    for key, data in pairs(ToolData) do
        local entry = { name = data.name, image = data.image }
        toolLookup[key] = entry
        if type(data.toolIndex) == "string" then
            toolLookup[data.toolIndex] = entry
        end
    end
end)

